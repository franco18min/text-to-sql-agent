# ============================================
# Text-to-SQL Agent - Environment Configuration
# ============================================
# cp env.example .env
# Editar .env con tus secretos reales. NO commitear .env (está en .gitignore).

# ----- Google Gemini (GRATIS) -----
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=tu_api_key_aqui
# Usar SIEMPRE el alias '-latest', no la version explícita (los X.Y-flash
# están bloqueados para nuevos usuarios desde 2025). Ver agent memory
# "Gemini free tier: which model to use".
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ----- Databricks (Free Edition) -----
# Host del workspace (sin https://)
# Ejemplo: adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_HOST=
# Personal Access Token (User Settings > Developer > Access Tokens)
# Permisos necesarios: SQL warehouse access, Unity Catalog read, Vector Search
DATABRICKS_TOKEN=
# HTTP Path del SQL Warehouse (SQL Warehouses > Connection Details)
# Ejemplo: /sql/1.0/warehouses/abc123def456
DATABRICKS_HTTP_PATH=
# Catalog + Schema target (samples.tpch es nativo de Databricks Free Edition)
DATABRICKS_CATALOG=samples
DATABRICKS_SCHEMA=tpch

# ----- Databricks Vector Search (Fase 3) -----
# Nombre del endpoint (lo creás en la UI: Compute > Vector Search > Create Endpoint)
DATABRICKS_VECTOR_SEARCH_ENDPOINT=text2sql-schema-endpoint
# Full name del índice (catalog.schema.index_name)
DATABRICKS_VECTOR_SEARCH_INDEX=text2sql_agent.schema_metadata

# ----- Agent behavior -----
MAX_RETRIES=3
MAX_QUERY_LENGTH=2000
MAX_RESULT_ROWS=1000
QUERY_TIMEOUT_SECONDS=30
# Si hay menos de N tablas, usar information_schema directo. Si hay más, Vector Search.
SCHEMA_RETRIEVAL_THRESHOLD=20

# ----- Memory -----
MEMORY_TYPE=in_memory  # opciones: in_memory, delta
SESSION_TIMEOUT_MINUTES=30

# ----- MLflow tracking (Fase 6) -----
# 'databricks' usa el tracking server del workspace (recomendado)
MLFLOW_TRACKING_URI=databricks
# /Users/<tu-email>/text2sql-agent o el path que quieras
MLFLOW_EXPERIMENT_NAME=/Users/tu_email@databricks.com/text2sql-agent

# ----- API -----
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
